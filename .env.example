# Copy to .env (or export these in your shell) to override the defaults.
# .env is gitignored - never commit real credentials.

# Database backend: auto | mysql | sqlite
# auto  -> try MySQL, fall back to SQLite so the project runs anywhere
STOCK_DB_BACKEND=auto

STOCK_DB_HOST=localhost
STOCK_DB_PORT=3306
STOCK_DB_USER=root
STOCK_DB_PASSWORD=change-me
STOCK_DB_NAME=guvi_db
